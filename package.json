{
  "name": "tb-crm",
  "version": "0.1.0",
  "private": true,
  "description": "PartnerOS CRM - \u591a\u79df\u6237SaaS B2B CRM",
  "author": "\u4e0a\u6d77\u753a\u840c\u7f51\u7edc\u79d1\u6280\u6709\u9650\u516c\u53f8",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint apps packages --max-warnings 0",
    "test": "pnpm --filter @partneros/api test",
    "db:migrate": "pnpm --filter @partneros/database migrate",
    "db:seed": "pnpm --filter @partneros/database seed",
    "db:studio": "pnpm --filter @partneros/database studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "typecheck": "pnpm --filter @partneros/database generate && pnpm --filter @partneros/api exec tsc --noEmit && pnpm --filter @partneros/web exec tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1"
  }
}
