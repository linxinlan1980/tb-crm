{
  "name": "tb-crm",
  "version": "0.2.0-demo.1",
  "private": true,
  "description": "PartnerOS CRM - 多租户SaaS B2B CRM",
  "author": "上海町萌网络科技有限公司",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint apps packages --max-warnings 0",
    "test": "pnpm --filter @partneros/api test",
    "db:migrate": "pnpm --filter @partneros/database migrate",
    "db:seed": "pnpm --filter @partneros/database seed",
    "db:studio": "pnpm --filter @partneros/database studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "typecheck": "pnpm --filter @partneros/database generate && pnpm --filter @partneros/api exec tsc --noEmit && pnpm --filter @partneros/web exec tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "demo:seed": "pnpm db:seed && pnpm --filter @partneros/database seed:demo",
    "demo:reset": "node --env-file=.env scripts/new-demo.mjs",
    "demo:test": "node --env-file=.env scripts/new-demo.mjs --test --verify",
    "demo:start": "node --env-file=.env scripts/start-demo.mjs"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1"
  }
}
