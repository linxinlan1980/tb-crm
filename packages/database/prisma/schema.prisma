// PartnerOS CRM - Prisma Schema
// 对应文档：docs/reference/qwen-design/03_数据库设计/DDL_schema.sql
// 含一致性检查报告补充的8张表（dictionaries/system_settings/approval_flows/approval_flow_nodes/ai_audit_logs/notification_rules/notification_templates/files/credit_check_logs）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============ 1. 租户与权限域 ============

model Tenant {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(30)
  plan        TenantPlan @default(basic)
  maxUsers    Int      @default(10) @map("max_users")
  maxCustomers Int     @default(1000) @map("max_customers")
  config      Json?
  brandLogo   String?  @map("brand_logo") @db.VarChar(500)
  brandColor  String?  @map("brand_color") @db.VarChar(10)
  status      TenantStatus @default(trial)
  trialEndsAt DateTime? @map("trial_ends_at") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  departments Department[]
  roles       Role[]

  @@map("tenants")
}

enum TenantPlan {
  basic
  professional
  enterprise
}

enum TenantStatus {
  trial
  active
  suspended
  cancelled
}

model Department {
  id        Int       @id @default(autoincrement())
  tenantId  Int       @map("tenant_id")
  parentId  Int?      @map("parent_id")
  name      String    @db.VarChar(100)
  code      String?   @db.VarChar(30)
  leaderId  Int?      @map("leader_id")
  sortOrder Int       @default(0) @map("sort_order")
  status    Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  parent    Department? @relation("DeptTree", fields: [parentId], references: [id])
  children  Department[] @relation("DeptTree")
  users     User[]

  @@index([tenantId])
  @@index([parentId])
  @@map("departments")
}

model User {
  id            Int        @id @default(autoincrement())
  tenantId      Int        @map("tenant_id")
  username      String     @db.VarChar(50)
  passwordHash  String     @map("password_hash") @db.VarChar(200)
  name          String     @db.VarChar(50)
  phone         String?    @db.VarChar(200)
  email         String?    @db.VarChar(100)
  avatarUrl     String?    @map("avatar_url") @db.VarChar(500)
  deptId        Int?       @map("dept_id")
  position      String?    @db.VarChar(50)
  dingtalkUserid String?   @map("dingtalk_userid") @db.VarChar(50)
  wecomUserid   String?    @map("wecom_userid") @db.VarChar(50)
  status        UserStatus @default(active)
  lastLoginAt   DateTime?  @map("last_login_at")
  createdBy     Int?       @map("created_by")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedBy     Int?       @map("updated_by")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  department    Department? @relation(fields: [deptId], references: [id])
  roles         UserRole[]

  @@unique([tenantId, username])
  @@index([tenantId, deptId])
  @@index([dingtalkUserid])
  @@map("users")
}

enum UserStatus {
  active
  inactive
  resigned
}

model Role {
  id               Int        @id @default(autoincrement())
  tenantId         Int        @map("tenant_id")
  name             String     @db.VarChar(50)
  code             String     @db.VarChar(30)
  description      String?    @db.VarChar(200)
  dataScope        DataScope  @default(self) @map("data_scope")
  isSystem         Boolean    @default(false) @map("is_system")
  permissions      Json?
  fieldPermissions Json?      @map("field_permissions")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  tenant           Tenant     @relation(fields: [tenantId], references: [id])
  userRoles        UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("roles")
}

enum DataScope {
  self
  team
  dept
  custom
  all
}

model UserRole {
  id       Int @id @default(autoincrement())
  tenantId Int @map("tenant_id")
  userId   Int @map("user_id")
  roleId   Int @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([tenantId, userId, roleId])
  @@index([userId])
  @@map("user_roles")
}

// ============ 2. 客户域 ============

model Customer {
  id                Int          @id @default(autoincrement())
  tenantId          Int          @map("tenant_id")
  code              String       @db.VarChar(20)
  name              String       @db.VarChar(200)
  shortName         String?      @map("short_name") @db.VarChar(100)
  groupId           Int?         @map("group_id")
  industry          String?      @db.VarChar(50)
  level             String?      @db.VarChar(20)
  source            String?      @db.VarChar(50)
  poolType          PoolType     @default(public) @map("pool_type")
  ownerId           Int?         @map("owner_id")
  ownerDeptId       Int?         @map("owner_dept_id")
  protectUntil      DateTime?    @map("protect_until") @db.Date
  status            CustomerStatus @default(active)
  isProspect        Boolean      @default(true) @map("is_prospect")
  isTrading         Boolean      @default(false) @map("is_trading")
  yonyouCode        String?      @map("yonyou_code") @db.VarChar(30)
  taxType           String?      @map("tax_type") @db.VarChar(20)
  currency          String       @default("CNY") @db.VarChar(10)
  address           String?      @db.VarChar(500)
  region            String?      @db.VarChar(50)
  website           String?      @db.VarChar(200)
  registeredCapital Decimal?     @map("registered_capital") @db.Decimal(15, 2)
  establishedDate   DateTime?    @map("established_date") @db.Date
  legalPerson       String?      @map("legal_person") @db.VarChar(50)
  creditCode        String?      @map("credit_code") @db.VarChar(18)
  employeeCount     String?      @map("employee_count") @db.VarChar(20)
  yonyouProduct     String?      @map("yonyou_product") @db.VarChar(100)
  yonyouModules     String?      @map("yonyou_modules") @db.Text
  serviceExpiry     DateTime?    @map("service_expiry") @db.Date
  contractCount     Int          @default(0) @map("contract_count")
  contractAmount    Decimal      @default(0) @map("contract_amount") @db.Decimal(15, 2)
  lastFollowAt      DateTime?    @map("last_follow_at")
  lastFollowBy      Int?         @map("last_follow_by")
  aiProfile         String?      @map("ai_profile") @db.Text
  aiProfileAt       DateTime?    @map("ai_profile_at")
  tags              Json?
  remark            String?      @db.Text
  createdBy         Int?         @map("created_by")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedBy         Int?         @map("updated_by")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  deletedAt         DateTime?    @map("deleted_at")

  contacts          Contact[]
  addresses         CustomerAddress[]
  banks             CustomerBank[]
  invoicesInfo      CustomerInvoiceInfo[]
  opportunities     Opportunity[]
  contracts         Contract[]
  orders            Order[]
  projects          Project[]
  leads             Lead[]

  @@unique([tenantId, code])
  @@index([tenantId, ownerId])
  @@index([tenantId, poolType])
  @@index([tenantId, industry])
  @@index([creditCode])
  @@index([name(50)])
  @@index([groupId])
  @@index([protectUntil])
  @@index([lastFollowAt])
  @@map("customers")
}

enum PoolType {
  public
  dept
  private
}

enum CustomerStatus {
  active
  inactive
  churned
}

model Contact {
  id           Int           @id @default(autoincrement())
  tenantId     Int           @map("tenant_id")
  customerId   Int           @map("customer_id")
  name         String        @db.VarChar(50)
  title        String?       @db.VarChar(50)
  department   String?       @db.VarChar(50)
  phone        String?       @db.VarChar(200)
  email        String?       @db.VarChar(100)
  wechat       String?       @db.VarChar(50)
  decisionRole DecisionRole? @map("decision_role")
  isPrimary    Boolean       @default(false) @map("is_primary")
  birthday     DateTime?     @db.Date
  preference   String?       @db.Text
  status       ContactStatus @default(active)
  createdBy    Int?          @map("created_by")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedBy    Int?          @map("updated_by")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  customer     Customer      @relation(fields: [customerId], references: [id])

  @@index([tenantId, customerId])
  @@map("contacts")
}

enum DecisionRole {
  decision_maker
  influencer
  user
  coach
  gatekeeper
}

enum ContactStatus {
  active
  inactive
}

model ContactRelation {
  id             Int            @id @default(autoincrement())
  tenantId       Int            @map("tenant_id")
  customerId     Int            @map("customer_id")
  fromContactId  Int            @map("from_contact_id")
  toContactId    Int            @map("to_contact_id")
  relationType   RelationType   @map("relation_type")
  strength       RelationStrength @default(medium)
  remark         String?        @db.VarChar(200)
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([tenantId, customerId])
  @@map("contact_relations")
}

enum RelationType {
  reports_to
  influences
  collaborates
  blocks
}

enum RelationStrength {
  strong
  medium
  weak
}

model CustomerAddress {
  id         Int           @id @default(autoincrement())
  tenantId   Int           @map("tenant_id")
  customerId Int           @map("customer_id")
  type       AddressType   @default(office)
  province   String?       @db.VarChar(20)
  city       String?       @db.VarChar(20)
  district   String?       @db.VarChar(20)
  detail     String        @db.VarChar(200)
  isDefault  Boolean       @default(false) @map("is_default")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  customer   Customer      @relation(fields: [customerId], references: [id])

  @@index([tenantId, customerId])
  @@map("customer_addresses")
}

enum AddressType {
  registered
  office
  delivery
  invoice
}

model CustomerBank {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @map("tenant_id")
  customerId  Int      @map("customer_id")
  bankName    String   @map("bank_name") @db.VarChar(100)
  accountName String   @map("account_name") @db.VarChar(200)
  accountNo   String   @map("account_no") @db.VarChar(200)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer    Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId, customerId])
  @@map("customer_banks")
}

model CustomerInvoiceInfo {
  id           Int      @id @default(autoincrement())
  tenantId     Int      @map("tenant_id")
  customerId   Int      @map("customer_id")
  invoiceTitle String   @map("invoice_title") @db.VarChar(200)
  taxNo        String   @map("tax_no") @db.VarChar(20)
  bankName     String?  @map("bank_name") @db.VarChar(100)
  bankAccount  String?  @map("bank_account") @db.VarChar(200)
  address      String?  @db.VarChar(200)
  phone        String?  @db.VarChar(20)
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer     Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId, customerId])
  @@map("customer_invoices_info")
}

// ============ 3. 线索域 ============

model Lead {
  id                    Int        @id @default(autoincrement())
  tenantId              Int        @map("tenant_id")
  code                  String     @db.VarChar(20)
  companyName           String     @map("company_name") @db.VarChar(200)
  contactName           String?    @map("contact_name") @db.VarChar(50)
  contactPhone          String?    @map("contact_phone") @db.VarChar(200)
  contactEmail          String?    @map("contact_email") @db.VarChar(100)
  contactTitle          String?    @map("contact_title") @db.VarChar(50)
  source                String     @db.VarChar(50)
  sourceDetail          String?    @map("source_detail") @db.VarChar(200)
  campaignId            Int?       @map("campaign_id")
  partnerId             Int?       @map("partner_id")
  industry              String?    @db.VarChar(50)
  region                String?    @db.VarChar(50)
  employeeCount         String?    @map("employee_count") @db.VarChar(20)
  demand                String?    @db.Text
  demandProducts        Json?      @map("demand_products")
  budgetRange           String?    @map("budget_range") @db.VarChar(30)
  expectedTime          String?    @map("expected_time") @db.VarChar(30)
  score                 Int        @default(0)
  scoreDetail           Json?      @map("score_detail")
  status                LeadStatus @default(new)
  qualityFlag           LeadQuality @default(valid) @map("quality_flag")
  assigneeId            Int?       @map("assignee_id")
  assignedAt            DateTime?  @map("assigned_at")
  convertedCustomerId   Int?       @map("converted_customer_id")
  convertedOpportunityId Int?      @map("converted_opportunity_id")
  convertedAt           DateTime?  @map("converted_at")
  rejectReason          String?    @map("reject_reason") @db.VarChar(200)
  expireAt              DateTime?  @map("expire_at")
  followCount           Int        @default(0) @map("follow_count")
  lastFollowAt          DateTime?  @map("last_follow_at")
  creditCode            String?    @map("credit_code") @db.VarChar(18)
  aiEnrichment          Json?      @map("ai_enrichment")
  remark                String?    @db.Text
  createdBy             Int?       @map("created_by")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedBy             Int?       @map("updated_by")
  updatedAt             DateTime   @updatedAt @map("updated_at")
  deletedAt             DateTime?  @map("deleted_at")

  customer              Customer?  @relation(fields: [convertedCustomerId], references: [id])
  followUps             LeadFollowUp[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, assigneeId])
  @@index([companyName(50)])
  @@index([creditCode])
  @@index([score])
  @@map("leads")
}

enum LeadStatus {
  new
  cleaning
  qualified
  unqualified
  assigned
  converted
  rejected
  expired
}

enum LeadQuality {
  valid
  invalid_phone
  duplicate
  not_target
  competitor
}

model LeadFollowUp {
  id           Int                @id @default(autoincrement())
  tenantId     Int                @map("tenant_id")
  leadId       Int                @map("lead_id")
  method       FollowMethod       @map("method")
  content      String             @db.Text
  result       LeadFollowResult?
  nextAction   String?            @map("next_action") @db.VarChar(200)
  nextFollowAt DateTime?          @map("next_follow_at")
  createdBy    Int                @map("created_by")
  createdAt    DateTime           @default(now()) @map("created_at")

  lead         Lead               @relation(fields: [leadId], references: [id])

  @@index([tenantId, leadId])
  @@map("lead_follow_ups")
}

enum LeadFollowResult {
  connected
  no_answer
  rejected
  interested
  need_follow
}

// ============ 4. 公私海域 ============

model PoolConfig {
  id                 Int            @id @default(autoincrement())
  tenantId           Int            @map("tenant_id")
  poolType           PoolConfigType @map("pool_type")
  deptId             Int?           @map("dept_id")
  name               String         @db.VarChar(50)
  maxClaimPerDay     Int            @default(3) @map("max_claim_per_day")
  protectDays        Int            @default(30) @map("protect_days")
  followRequiredDays Int            @default(15) @map("follow_required_days")
  autoRecycleDays    Int            @default(60) @map("auto_recycle_days")
  recycleTo          PoolType       @default(public) @map("recycle_to")
  privateMax         Int            @default(50) @map("private_max")
  claimNeedApproval  Boolean        @default(false) @map("claim_need_approval")
  assignStrategy     AssignStrategy @default(manual) @map("assign_strategy")
  isActive           Boolean        @default(true) @map("is_active")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("pool_configs")
}

enum PoolConfigType {
  public
  dept
}

enum AssignStrategy {
  manual
  round_robin
  region
  industry
  load
  ai
}

model PoolLog {
  id          Int          @id @default(autoincrement())
  tenantId    Int          @map("tenant_id")
  customerId  Int          @map("customer_id")
  action      PoolAction
  fromPool    PoolType     @map("from_pool")
  toPool      PoolType     @map("to_pool")
  fromOwnerId Int?         @map("from_owner_id")
  toOwnerId   Int?         @map("to_owner_id")
  fromDeptId  Int?         @map("from_dept_id")
  toDeptId    Int?         @map("to_dept_id")
  reason      String?      @db.VarChar(200)
  protectUntil DateTime?   @map("protect_until") @db.Date
  operatorId  Int          @map("operator_id")
  isAuto      Boolean      @default(false) @map("is_auto")
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
  @@index([operatorId])
  @@map("pool_logs")
}

enum PoolAction {
  claim
  assign
  return
  recycle
  transfer
  dept_assign
}

model PrivateHolding {
  id           Int       @id @default(autoincrement())
  tenantId     Int       @map("tenant_id")
  userId       Int       @map("user_id")
  customerId   Int       @map("customer_id")
  claimedAt    DateTime  @map("claimed_at")
  protectUntil DateTime  @map("protect_until") @db.Date
  lastFollowAt DateTime? @map("last_follow_at")
  followCount  Int       @default(0) @map("follow_count")
  isExpired    Boolean   @default(false) @map("is_expired")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, userId, customerId])
  @@index([protectUntil])
  @@index([tenantId, userId])
  @@map("private_holdings")
}

// ============ 5. 商机域 ============

model OpportunityStage {
  id                Int      @id @default(autoincrement())
  tenantId          Int      @map("tenant_id")
  code              String   @db.VarChar(30)
  name              String   @db.VarChar(50)
  sortOrder         Int      @map("sort_order")
  probability       Int      @default(0)
  stallThresholdDays Int     @default(30) @map("stall_threshold_days")
  entryCriteria     String?  @map("entry_criteria") @db.Text
  exitActions       String?  @map("exit_actions") @db.Text
  requiredFields    Json?    @map("required_fields")
  isWon             Boolean  @default(false) @map("is_won")
  isLost            Boolean  @default(false) @map("is_lost")
  color             String?  @db.VarChar(10)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([tenantId, code])
  @@index([tenantId, sortOrder])
  @@map("opportunity_stages")
}

model Opportunity {
  id                Int              @id @default(autoincrement())
  tenantId          Int              @map("tenant_id")
  code              String           @db.VarChar(20)
  name              String           @db.VarChar(200)
  customerId        Int              @map("customer_id")
  contactId         Int?             @map("contact_id")
  leadId            Int?             @map("lead_id")
  partnerId         Int?             @map("partner_id")
  ownerId           Int              @map("owner_id")
  teamIds           Json?            @map("team_ids")
  stage             String           @default("intention") @db.VarChar(30)
  stageEnteredAt    DateTime         @default(now()) @map("stage_entered_at")
  stageHistory      Json?            @map("stage_history")
  amount            Decimal          @default(0) @db.Decimal(15, 2)
  weightedAmount    Decimal          @default(0) @map("weighted_amount") @db.Decimal(15, 2)
  expectedCloseDate DateTime?        @map("expected_close_date") @db.Date
  expectedRevenueYear Int?           @map("expected_revenue_year")
  productIds        Json?            @map("product_ids")
  demandSummary     String?          @map("demand_summary") @db.Text
  source            String?          @db.VarChar(50)
  competitorIds     Json?            @map("competitor_ids")
  competitorNote    String?          @map("competitor_note") @db.Text
  priority          OppPriority      @default(medium)
  isKey             Boolean          @default(false) @map("is_key")
  healthScore       Int?             @map("health_score")
  healthFactors     Json?            @map("health_factors")
  healthLevel       HealthLevel?     @map("health_level")
  status            OppStatus        @default(open)
  winDate           DateTime?        @map("win_date") @db.Date
  lossReason        String?          @map("loss_reason") @db.VarChar(30)
  lossDetail        String?          @map("loss_detail") @db.VarChar(500)
  contractId        Int?             @map("contract_id")
  projectId         Int?             @map("project_id")
  nextAction        String?          @map("next_action") @db.VarChar(200)
  nextActionDate    DateTime?        @map("next_action_date") @db.Date
  lastFollowAt      DateTime?        @map("last_follow_at")
  followCount       Int              @default(0) @map("follow_count")
  stageStallDays    Int              @default(0) @map("stage_stall_days")
  remark            String?          @db.Text
  createdBy         Int?             @map("created_by")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedBy         Int?             @map("updated_by")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  deletedAt         DateTime?        @map("deleted_at")

  customer          Customer         @relation(fields: [customerId], references: [id])
  products          OpportunityProduct[]
  reviews           OpportunityReview[]

  @@unique([tenantId, code])
  @@index([tenantId, ownerId])
  @@index([tenantId, customerId])
  @@index([tenantId, stage])
  @@index([tenantId, status])
  @@index([expectedCloseDate])
  @@index([healthLevel])
  @@map("opportunities")
}

enum OppPriority {
  high
  medium
  low
}
enum HealthLevel {
  green
  yellow
  red
}
enum OppStatus {
  open
  won
  lost
  cancelled
  on_hold
}

model OpportunityProduct {
  id              Int      @id @default(autoincrement())
  tenantId        Int      @map("tenant_id")
  opportunityId   Int      @map("opportunity_id")
  productId       Int?     @map("product_id")
  productName     String?  @map("product_name") @db.VarChar(200)
  quantity        Int      @default(1)
  estimatedPrice  Decimal? @map("estimated_price") @db.Decimal(12, 2)
  estimatedAmount Decimal? @map("estimated_amount") @db.Decimal(15, 2)
  remark          String?  @db.VarChar(200)
  createdAt       DateTime @default(now()) @map("created_at")

  opportunity     Opportunity @relation(fields: [opportunityId], references: [id])

  @@index([opportunityId])
  @@map("opportunity_products")
}

model OpportunityReview {
  id            Int          @id @default(autoincrement())
  tenantId      Int          @map("tenant_id")
  opportunityId Int          @map("opportunity_id")
  reviewType    ReviewType   @map("review_type")
  reviewerId    Int          @map("reviewer_id")
  result        ReviewResult
  comments      String?      @db.Text
