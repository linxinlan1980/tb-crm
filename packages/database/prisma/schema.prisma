  exceedAmount   Decimal?     @map("exceed_amount") @db.Decimal(15, 2)
  result         CreditResult
  overrideReason String?      @map("override_reason") @db.VarChar(200)
  operatorId     Int          @map("operator_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([tenantId, customerId])
  @@index([orderId])
  @@index([tenantId, createdAt])
  @@map("credit_check_logs")
}

// Durable idempotency for authenticated business commands.
model CommandExecution {
  id Int @id @default(autoincrement())
  tenantId Int @map("tenant_id")
  actorId Int @map("actor_id")
  requestKey String @map("request_key") @db.VarChar(80)
  command String @db.VarChar(100)
  payloadHash String @map("payload_hash") @db.VarChar(64)
  result Json
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([tenantId, actorId, requestKey])
  @@map("command_executions")
}
