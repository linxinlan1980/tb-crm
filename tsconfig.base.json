{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "paths": {
      "@partneros/shared": [
        "./packages/shared/src"
      ],
      "@partneros/shared/*": [
        "./packages/shared/src/*"
      ],
      "@partneros/database": [
        "./packages/database/src"
      ],
      "@partneros/database/*": [
        "./packages/database/src/*"
      ]
    },
    "baseUrl": "."
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}
